{
  "name": "LinkedIn Content Generator",
  "nodes": [
    {
      "parameters": {
        "formTitle": "LinkedIn Post Generator",
        "formDescription": "Enter a topic and get 3 ready-to-post LinkedIn post variations.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "placeholder": "e.g. Why automation is changing marketing",
              "requiredField": true
            },
            {
              "fieldLabel": "Target Audience",
              "placeholder": "e.g. marketing managers, small business owners",
              "requiredField": false
            },
            {
              "fieldLabel": "Key Point To Include (optional)",
              "placeholder": "e.g. mention our 30-minute build time",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "f1a1b111-0001-4a11-8a11-000000000001",
      "name": "TopicForm",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a LinkedIn content strategist and ghostwriter. Write 3 distinct LinkedIn post variations about the topic below, each in a different style. Keep each post between 100-200 words, formatted with short paragraphs and line breaks (no markdown symbols, just plain text with line breaks like real LinkedIn posts). Each post must open with a strong hook in the first 1-2 lines, and end with a call-to-action or question to drive engagement.\n\nStyles required (one post per style):\n1. Educational - teaches the reader something useful, step-by-step or listicle style.\n2. Personal Story - written in first person, as a short relatable anecdote that leads into the lesson/point.\n3. Opinion/Hot Take - a confident point of view or contrarian take on the topic, backed by a short reason.\n\nAlso generate a set of 5-8 relevant, non-spammy LinkedIn hashtags.\n\nTopic: {{ $json.Topic }}\nTarget Audience: {{ $json['Target Audience'] || 'general professional audience' }}\nKey Point To Include: {{ $json['Key Point To Include (optional)'] || 'none specified' }}",
        "hasOutputParser": true
      },
      "id": "f1a1b111-0002-4a11-8a11-000000000002",
      "name": "GeneratePostVariations",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"variations\": [\n    {\n      \"style\": \"educational\",\n      \"post\": \"Full post text here...\"\n    },\n    {\n      \"style\": \"personal_story\",\n      \"post\": \"Full post text here...\"\n    },\n    {\n      \"style\": \"opinion\",\n      \"post\": \"Full post text here...\"\n    }\n  ],\n  \"hashtags\": [\"#Automation\", \"#Marketing\", \"#AI\"]\n}"
      },
      "id": "f1a1b111-0003-4a11-8a11-000000000003",
      "name": "OutputParser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1040,
        520
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0.7
        }
      },
      "id": "f1a1b111-0004-4a11-8a11-000000000004",
      "name": "gpt-oss-120b",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        920,
        520
      ],
      "credentials": {
        "groqApi": {
          "id": "REPLACE_WITH_YOUR_GROQ_CREDENTIAL_ID",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "topic",
              "value": "={{ $('TopicForm').item.json.Topic }}",
              "type": "string"
            },
            {
              "id": "b",
              "name": "educational_post",
              "value": "={{ $json.output.variations.find(v => v.style === 'educational').post }}",
              "type": "string"
            },
            {
              "id": "c",
              "name": "personal_story_post",
              "value": "={{ $json.output.variations.find(v => v.style === 'personal_story').post }}",
              "type": "string"
            },
            {
              "id": "d",
              "name": "opinion_post",
              "value": "={{ $json.output.variations.find(v => v.style === 'opinion').post }}",
              "type": "string"
            },
            {
              "id": "e",
              "name": "hashtags",
              "value": "={{ $json.output.hashtags.join(' ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f1a1b111-0005-4a11-8a11-000000000005",
      "name": "FormatOutput",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Your LinkedIn Posts Are Ready!",
        "completionMessage": "=Here are your 3 LinkedIn post variations for: {{ $json.topic }}\n\n--- EDUCATIONAL ---\n{{ $json.educational_post }}\n\n--- PERSONAL STORY ---\n{{ $json.personal_story_post }}\n\n--- OPINION ---\n{{ $json.opinion_post }}\n\n--- HASHTAGS ---\n{{ $json.hashtags }}",
        "options": {}
      },
      "id": "f1a1b111-0006-4a11-8a11-000000000006",
      "name": "RespondToForm",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        1520,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "TopicForm": {
      "main": [
        [
          {
            "node": "GeneratePostVariations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GeneratePostVariations": {
      "main": [
        [
          {
            "node": "FormatOutput",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "gpt-oss-120b": {
      "ai_languageModel": [
        [
          {
            "node": "GeneratePostVariations",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "OutputParser": {
      "ai_outputParser": [
        [
          {
            "node": "GeneratePostVariations",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "FormatOutput": {
      "main": [
        [
          {
            "node": "RespondToForm",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
